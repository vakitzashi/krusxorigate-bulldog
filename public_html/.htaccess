DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off

RewriteEngine On

# One canonical origin: HTTPS without www, and no duplicate /index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://origate-tactic.ru/ [R=301,L,NE]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^origate-tactic\.ru$ [NC]
RewriteRule ^ https://origate-tactic.ru%{REQUEST_URI} [R=301,L,NE]

# PHP libraries are available only to server-side includes.
<FilesMatch "^(admin-lib|cdek-lib|onec-lib)\.php$">
  Require all denied
</FilesMatch>

# Never serve source, credentials, database dumps, logs, keys, or deployment files.
<FilesMatch "(^\.|\.(?:bak|conf|env|ini|key|log|md|pem|ps1|sh|sql|sqlite3?|tar|tgz|ya?ml|zip)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  <FilesMatch "^(admin|order|delivery|stock|1c_exchange)\.php$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
